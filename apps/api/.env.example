# Copy to .env for local runs against real Firebase. Never commit .env.
# On Vercel, set the same two names in the project's environment variables.

# The whole service account key file, on one line.
FIREBASE_SERVICE_ACCOUNT=

# At least 32 random characters, different for staging and production.
# Anyone who has this can work out future prices. Make one with: openssl rand -hex 32
WORLD_SEED=
