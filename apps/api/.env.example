# Copy to .env for local runs against real Firebase. Never commit .env.
# On Vercel, set the same four names in the project's environment variables.

# The whole service account key file, on one line.
FIREBASE_SERVICE_ACCOUNT=

# At least 32 random characters, different for staging and production.
# Anyone who has this can work out future prices. Make one with: openssl rand -hex 32
WORLD_SEED=

# At least 32 random characters. The cron sends this to fill orders. Make one with: openssl rand -hex 32
TICK_SECRET=

# At least 32 random characters. This is the admin code for /admin: it moves the clock, pauses
# trading, adds and deletes bots, and deletes real players. Share it only with people trusted to do that.
CLOCK_SECRET=
